# Leave empty to run on mock data (src/lib/api/mock).
# Set to /api to use the built-in backend (server/, served by `npm run dev` and on Vercel)
VITE_API_URL=

# Server-side secrets (local dev reads them from .env.local; never prefix with VITE_)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Written by `npm run setup:agents`
ELEVENLABS_INTERVIEWER_AGENT_ID=
ELEVENLABS_TUTOR_AGENT_ID=
ELEVENLABS_SUPERVISOR_AGENT_ID=
ELEVENLABS_DRAFTER_AGENT_ID=
# Optional model overrides (defaults: vision + focus claude-haiku-4-5, reasoning claude-opus-5-5)
# SOCRATES_VISION_MODEL=
# SOCRATES_FOCUS_MODEL=
# SOCRATES_REASONING_MODEL=
