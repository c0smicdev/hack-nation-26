{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "includeFiles": "prompts/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:path(.*)", "destination": "/api?route=/:path" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
